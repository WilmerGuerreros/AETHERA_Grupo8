from config_de_carpetas import obtener_ultimo_archivo 

def inicializar_memoria():

    archivo_ultimo, contador = obtener_ultimo_archivo()

    # Caso: Aethera todavía no tiene historial
    if archivo_ultimo is None:

        return 1, 0

    numero_seccion = int(
        archivo_ultimo.stem.split("_")[1]
    )

    # Si el archivo anterior ya está lleno,
    # empezar una sección nueva
    if contador >= 20:

        return numero_seccion + 1, 0

    return numero_seccion, contador