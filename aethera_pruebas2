from pathlib import Path
from datetime import datetime
import json
import ollama


carpeta_memoria = Path("MEMORIA DE AETHERA AI")

carpeta_historial = carpeta_memoria / "HISTORIAL"
carpeta_resumen = carpeta_memoria / "RESUMEN"
carpeta_indice = carpeta_memoria / "INDICE"


carpeta_historial.mkdir(parents=True, exist_ok=True)
carpeta_resumen.mkdir(parents=True, exist_ok=True)
carpeta_indice.mkdir(parents=True, exist_ok=True)

def inicializar_memoria():

    numero = 1

    # Buscar el primer historial que NO exista
    while True:

        archivo = carpeta_memoria / f"HISTORIAL_{numero:04d}.txt"

        if archivo.exists():
            numero += 1

        else:
            break

    # --------------------------------------------------------
    # Caso 1: todavía no existe ningún historial
    # --------------------------------------------------------

    if numero == 1:

        return 1, 0

    # --------------------------------------------------------
    # Caso 2: ya existen historiales
    # --------------------------------------------------------

    ultimo_numero = numero - 1

    ultimo_archivo = (
        carpeta_memoria /
        f"HISTORIAL_{ultimo_numero:04d}.txt"
    )

    contador = 0

    # Leer el último archivo y contar conversaciones
    with open(ultimo_archivo, "r", encoding="utf-8") as f:

        for linea in f:

            if linea.startswith("Usuario:"):
                contador += 1

    # --------------------------------------------------------
    # Si el último archivo ya está lleno,
    # empezamos uno nuevo.
    # --------------------------------------------------------

    if contador >= 20:

        return ultimo_numero + 1, 0

    else:

        return ultimo_numero, contador


# Recuperar automáticamente el estado de la memoria
numero_seccion, contador_mensajes = inicializar_memoria()



print("Memoria de Aethera inicializada.")
print(f"Sección actual: {numero_seccion:04d}")
print(f"Conversaciones en la sección: {contador_mensajes}/20")


# ============================================================
# FUNCIÓN PARA GUARDAR HISTORIAL
# ============================================================

def guardar_historial(usuario, respuesta):

    global numero_seccion
    global contador_mensajes

    archivo = carpeta_memoria / f"HISTORIAL_{numero_seccion:04d}.txt"

    fecha = datetime.now().strftime("%Y-%m-%d %H:%M:%S")

    with open(archivo, "a", encoding="utf-8") as f:

        f.write("\n" + "=" * 60 + "\n")
        f.write(f"Fecha: {fecha}\n")
        f.write("=" * 60 + "\n")

        f.write(f"Usuario: {usuario}\n")
        f.write(f"Aethera: {respuesta}\n")

    contador_mensajes += 1

    if contador_mensajes >= 20:

        print("\nGenerando resumen de memoria...")

    generar_resumen(
        archivo,
        numero_seccion
    )

    print("Resumen guardado.")

    numero_seccion += 1
    contador_mensajes = 0

# ============================================================
# FUNCIÓN PARA GEENRAR RESÚMENSE
# ============================================================

def generar_resumen(archivo_historial, numero_seccion):

    # Leer el historial completo
    with open(archivo_historial, "r", encoding="utf-8") as f:
        historial = f.read()


    prompt = f"""
    Analiza el siguiente historial de conversación de Aethera.

    Genera un resumen MUY COMPACTO de máximo 8 puntos clave.

    Conserva únicamente información útil para futuras conversaciones,
    como:
    - proyectos
    - decisiones tomadas
    - conocimientos adquiridos
    - problemas pendientes
    - configuraciones importantes
    - preferencias relacionadas con el proyecto

    No inventes información.
    No agregues conclusiones que no aparezcan en el historial.

    HISTORIAL:

    {historial}
    """


    respuesta = ollama.chat(

        model="nemotron-3-super:cloud",

        messages=[
            {
                "role": "system",
                "content": """
                Eres el sistema de memoria de Aethera.
                Tu trabajo es comprimir conversaciones anteriores
                sin inventar información.
                """
            },
            {
                "role": "user",
                "content": prompt
            }
        ]

    )


    resumen = respuesta.message.content


    archivo_resumen = (
        carpeta_resumen /
        f"RESUMEN_{numero_seccion:04d}.txt"
    )


    with open(archivo_resumen, "w", encoding="utf-8") as f:

        f.write(f"RESUMEN DE HISTORIAL {numero_seccion:04d}\n")
        f.write("=" * 60 + "\n\n")
        f.write(resumen)


    return archivo_resumen

