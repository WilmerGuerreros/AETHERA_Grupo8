# ============================================================
# GENERAR ÍNDICE [CASO EXISTE Y NO EXISTE]
# ============================================================
def cargar_indice():

    archivo_indice = carpeta_indice / "INDICE_MEMORIA.json"

    if archivo_indice.exists():

        with open(archivo_indice, "r", encoding="utf-8") as f:

            return json.load(f)

    else:

        return {
            "secciones": [],
            "temas": {}
        }

# ============================================================
# ACTUALIZAR ÍNDICE
# ============================================================
def actualizar_indice(numero_seccion, archivo_historial, archivo_resumen):

    archivo_indice = carpeta_indice / "INDICE_MEMORIA.json"

    indice = cargar_indice()


    nueva_seccion = {

        "id": numero_seccion,

        "historial": archivo_historial.name,

        "resumen": archivo_resumen.name

    }


    indice["secciones"].append(nueva_seccion)


    with open(archivo_indice, "w", encoding="utf-8") as f:

        json.dump(
            indice,
            f,
            indent=4,
            ensure_ascii=False
        )

# ============================================================
# INVOCAR ACTU_ÍNDICE + GEN_RESUMEN
# ============================================================ 
archivo_resumen = generar_resumen(
    archivo,
    numero_seccion
)

actualizar_indice(
    numero_seccion,
    archivo,
    archivo_resumen
)

# ============================================================
# CONVERSACIÓN
# ============================================================

while True:

    usuario = input("\nTú: ")

    if usuario.lower() == "salir":

        print("Aethera: ¡Hasta luego!")

        break


    mensajes.append({

        "role": "user",
        "content": usuario

    })


    respuesta = ollama.chat(

        model="nemotron-3-super:cloud",

        messages=mensajes

    )


    mensajes.append(respuesta.message)

    texto_respuesta = respuesta.message.content


    print("\nAethera:", texto_respuesta)


    guardar_historial(

        usuario,
        texto_respuesta

    )

