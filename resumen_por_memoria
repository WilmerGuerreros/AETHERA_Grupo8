import ollama 
from config_de_carpetas import carpeta_resumen 
from config_de_carpetas import carpeta_historial 
from config_de_carpetas import carpeta_indice 

def generar_resumen(archivo_historial, numero_seccion):

    print("\nGenerando resumen de memoria...")

    # Leer historial completo
    with open(archivo_historial, "r", encoding="utf-8") as f:

        historial = f.read()

    prompt = f"""
Analiza el siguiente historial de conversación de Aethera.

Genera un resumen MUY COMPACTO de máximo 8 puntos clave.

Conserva únicamente información útil para futuras conversaciones,
como:

- proyectos
- decisiones tomadas
- conocimientos adquiridos
- problemas pendientes
- configuraciones importantes
- preferencias relacionadas con el proyecto

No inventes información.
No agregues conclusiones que no aparezcan en el historial.

HISTORIAL:

{historial}
"""

    respuesta = ollama.chat(

        model="nemotron-3-super:cloud",

        messages=[

            {
                "role": "system",
                "content": """
Eres el sistema de memoria de Aethera.

Tu trabajo es comprimir conversaciones anteriores
sin inventar información.

Prioriza información útil para futuras conversaciones.
"""
            },

            {
                "role": "user",
                "content": prompt
            }

        ]

    )

    resumen = respuesta.message.content

    archivo_resumen = (
        carpeta_resumen /
        f"RESUMEN_{numero_seccion:04d}.txt"
    )

    with open(archivo_resumen, "w", encoding="utf-8") as f:

        f.write(
            f"RESUMEN DE HISTORIAL {numero_seccion:04d}\n"
        )

        f.write("=" * 60 + "\n\n")

        f.write(resumen)

    return archivo_resumen
